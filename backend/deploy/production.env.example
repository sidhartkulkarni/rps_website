# REVIEWED TEMPLATE ONLY. Not a credential file; replace placeholders securely on EC2.
# /etc/rps-website-api/environment must be root:root 0600, parent directory 0700.
# Never source, print or commit the populated file. Not automatically loaded by Python.
WEBSITE_ENVIRONMENT=production
WEBSITE_PROVIDER=smtp
WEBSITE_ALLOWED_ORIGINS=["https://rapidpacknship.com"]
WEBSITE_PUBLIC_ORIGIN=https://rapidpacknship.com
WEBSITE_LEDGER_PATH=/var/lib/rps-website-api/delivery.sqlite3
WEBSITE_FINGERPRINT_SECRET=<STABLE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS>
WEBSITE_SUBSCRIBER_ENCRYPTION_KEY=<STABLE_FERNET_KEY>
WEBSITE_SMTP_HOST=smtp.gmail.com
WEBSITE_SMTP_PORT=587
WEBSITE_SMTP_TLS=starttls
WEBSITE_SMTP_USERNAME=<AUTHORIZED_GOOGLE_ACCOUNT_FULL_EMAIL>
WEBSITE_SMTP_PASSWORD=<APP_PASSWORD_PROVISIONED_SECURELY_BY_OPERATOR>
WEBSITE_MAIL_FROM=noreply@rapidpacknship.com
WEBSITE_MAIL_FROM_NAME=RapidPacknShip
WEBSITE_MAIL_TO=mark@rapidpacknship.com
WEBSITE_MAIL_REPLY_TO=mark@rapidpacknship.com
WEBSITE_SMTP_TIMEOUT=8
WEBSITE_DELIVERY_TIMEOUT=20
WEBSITE_HEALTH_TIMEOUT=8
WEBSITE_HEALTH_CACHE_SECONDS=30
WEBSITE_MAX_INFLIGHT=2
WEBSITE_REQUEST_TIMEOUT=10
WEBSITE_RATE_LIMIT=5
WEBSITE_RATE_WINDOW=600
# Conservative example only: approve actual shared-account budget before enabling.
# This is a rolling request-window quota, NOT a daily mail quota or Admin reservation.
WEBSITE_GLOBAL_LIMIT=5
WEBSITE_NEWSLETTER_COOLDOWN=900
WEBSITE_NEWSLETTER_DAILY_LIMIT=3
WEBSITE_CONFIRMATION_TTL=172800
WEBSITE_SUBSCRIBER_RETENTION_DAYS=30
