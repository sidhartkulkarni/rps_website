# Review-only replacement for the existing website virtual host's /api/website/ 503 location.
# Do not include alongside another matching location. Do not touch Admin virtual hosts.
location ^~ /api/website/ {
    proxy_pass http://127.0.0.1:8017;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    client_max_body_size 16k;
    client_body_timeout 10s;
    proxy_connect_timeout 2s;
    proxy_send_timeout 15s;
    proxy_read_timeout 40s;
    proxy_request_buffering on;
    proxy_next_upstream off;
    proxy_cache off;
    access_log off;
    # Suppress per-request upstream error lines, which can include attacker-supplied query strings.
    error_log /dev/null crit;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
}
