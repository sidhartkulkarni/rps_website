# Variable names only. Not loaded automatically; never commit a filled environment file.
WEBSITE_ENVIRONMENT=development
WEBSITE_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8001","http://127.0.0.1:8001"]
WEBSITE_PUBLIC_ORIGIN=http://localhost:8001
WEBSITE_PROVIDER=disabled
WEBSITE_LEDGER_PATH=/tmp/rps-website-delivery.sqlite3
# WEBSITE_FINGERPRINT_SECRET=
# WEBSITE_SUBSCRIBER_ENCRYPTION_KEY=
# WEBSITE_SMTP_HOST=
WEBSITE_SMTP_PORT=587
WEBSITE_SMTP_TLS=starttls
# WEBSITE_SMTP_USERNAME=
# WEBSITE_SMTP_PASSWORD=
# WEBSITE_MAIL_FROM=
# WEBSITE_MAIL_TO=
WEBSITE_MAIL_FROM_NAME=RapidPacknShip
# WEBSITE_MAIL_REPLY_TO=
WEBSITE_SMTP_TIMEOUT=8
WEBSITE_DELIVERY_TIMEOUT=20
WEBSITE_HEALTH_TIMEOUT=8
WEBSITE_HEALTH_CACHE_SECONDS=30
WEBSITE_MAX_INFLIGHT=2
WEBSITE_REQUEST_TIMEOUT=10
WEBSITE_RATE_LIMIT=5
WEBSITE_RATE_WINDOW=600
WEBSITE_GLOBAL_LIMIT=100
WEBSITE_NEWSLETTER_COOLDOWN=900
WEBSITE_NEWSLETTER_DAILY_LIMIT=3
WEBSITE_CONFIRMATION_TTL=172800
WEBSITE_SUBSCRIBER_RETENTION_DAYS=30
